<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="esprit.fx.controllers.UserListController"
      spacing="0" stylesheets="@css/arij-styles.css"
      style="-fx-background-color: #f0f4f8;">

    <HBox alignment="CENTER_LEFT" styleClass="page-header" spacing="12">
        <padding><Insets top="28" right="32" bottom="20" left="32"/></padding>
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Users" styleClass="page-title"/>
            <Label text="Liste des utilisateurs de la plateforme" styleClass="page-subtitle"/>
        </VBox>
        <Button text="Ajouter" styleClass="btn-primary" onAction="#openAddUserDialog"/>
        <Button text="Actualiser" styleClass="btn-secondary" onAction="#refreshUsers"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll">
        <padding><Insets top="18" right="32" bottom="24" left="32"/></padding>
        <content>
            <VBox spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color:white; -fx-background-radius:10; -fx-padding:14; -fx-border-color:#e5e7eb; -fx-border-radius:10;">
                    <Label text="Rechercher" styleClass="filter-label"/>
                    <TextField fx:id="searchField" promptText="Username, email, role..." styleClass="search-field" prefWidth="360"/>
                    <Label text="Role" styleClass="filter-label"/>
                    <ComboBox fx:id="roleFilterComboBox" prefWidth="140" styleClass="filter-combo"/>
                    <Label text="Statut" styleClass="filter-label"/>
                    <ComboBox fx:id="statusFilterComboBox" prefWidth="140" styleClass="filter-combo"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="resultCountLabel" text="0 user(s)" styleClass="muted"/>
                </HBox>

                <VBox fx:id="cardsContainer" spacing="12"/>
            </VBox>
        </content>
    </ScrollPane>
</VBox>

