<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="esprit.fx.controllers.UserListController"
      spacing="0"
      style="-fx-background-color: #f0f4f8;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
        <padding><Insets top="24" right="32" bottom="20" left="32"/></padding>
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Utilisateurs"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
            <Label text="Gérez les comptes de la plateforme"
                   style="-fx-font-size: 12px; -fx-text-fill: #9E9E9E;"/>
        </VBox>
        <Button text="+ Ajouter" onAction="#openAddUserDialog"
                style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-background-radius: 8; -fx-padding: 8 18; -fx-cursor: hand;"/>
    </HBox>

    <!-- Filters -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
        <padding><Insets top="12" right="32" bottom="12" left="32"/></padding>
        <TextField fx:id="searchField" promptText="Rechercher par username ou email..."
                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e0e0e0;
                          -fx-padding: 7 12; -fx-font-size: 13px;"
                   prefWidth="280"/>
        <ComboBox fx:id="roleFilterComboBox" prefWidth="140"
                  style="-fx-background-radius: 8; -fx-font-size: 13px;"/>
        <ComboBox fx:id="statusFilterComboBox" prefWidth="140"
                  style="-fx-background-radius: 8; -fx-font-size: 13px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="resultCountLabel" text="0 utilisateur(s)"
               style="-fx-text-fill: #9E9E9E; -fx-font-size: 12px;"/>
    </HBox>

    <!-- Cards -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <padding><Insets top="20" right="32" bottom="24" left="32"/></padding>
        <content>
            <VBox fx:id="cardsContainer" spacing="10"/>
        </content>
    </ScrollPane>

</VBox>
