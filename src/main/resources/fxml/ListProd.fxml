<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="esprit.fx.controllers.ListeProduitController"
      style="-fx-background-color: #f0f4f8;">

    <!-- Header gradient -->
    <VBox style="-fx-background-color: linear-gradient(to right, #1d4ed8 0%, #0ea5e9 100%);">
        <padding><Insets top="22" right="32" bottom="18" left="32"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="MedTime Marketplace"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Découvrez nos produits pharmaceutiques"
                       style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9);"/>
            </VBox>
            <Label fx:id="lblStatus"
                   style="-fx-font-size: 12px; -fx-text-fill: #1d4ed8; -fx-font-weight: bold;
                          -fx-background-color: #eff6ff; -fx-background-radius: 20;
                          -fx-padding: 4 12;"/>
        </HBox>
    </VBox>

    <!-- Barre de recherche + actions -->
    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
        <padding><Insets top="12" right="32" bottom="10" left="32"/></padding>

        <!-- Champ de recherche -->
        <HBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS"
              style="-fx-background-color: #f8f9fa; -fx-background-radius: 25;
                     -fx-border-color: #cbd5e1; -fx-border-radius: 25; -fx-border-width: 1.5;
                     -fx-padding: 6 16;">
            <Label text="🔍" style="-fx-font-size: 14px;"/>
            <TextField fx:id="txtSearch" promptText="Rechercher un produit, une marque..."
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color: transparent; -fx-border-color: transparent;
                              -fx-font-size: 13px; -fx-text-fill: #0f172a;"/>
        </HBox>

        <!-- Bouton Analyse IA -->
        <Button fx:id="btnAnalyse" text="Analyse IA" onAction="#onSmartSearch"
                style="-fx-background-color: #eff6ff; -fx-text-fill: #1d4ed8;
                       -fx-border-color: #bfdbfe; -fx-border-width: 1; -fx-border-radius: 20;
                       -fx-font-weight: bold; -fx-font-size: 12px;
                       -fx-background-radius: 20; -fx-padding: 9 18;"/>

        <!-- Bouton Ajouter -->
        <Button fx:id="btnAjouter" text="+ Ajouter" onAction="#handleAjouter"
                style="-fx-background-color: #eff6ff; -fx-text-fill: #1d4ed8;
                       -fx-border-color: #bfdbfe; -fx-border-width: 1; -fx-border-radius: 20;
                       -fx-font-weight: bold; -fx-font-size: 12px;
                       -fx-background-radius: 20; -fx-padding: 9 18;"/>

        <!-- Bouton Favoris -->
        <Button text="Favoris" onAction="#handleMesFavoris"
                style="-fx-background-color: #eff6ff; -fx-text-fill: #1d4ed8;
                       -fx-border-color: #bfdbfe; -fx-border-width: 1; -fx-border-radius: 20;
                       -fx-font-weight: bold; -fx-font-size: 12px;
                       -fx-background-radius: 20; -fx-padding: 9 18;"/>

        <!-- Bouton Panier -->
        <Button text="Panier" onAction="#handleMonPanier"
                style="-fx-background-color: #eff6ff; -fx-text-fill: #1d4ed8;
                       -fx-border-color: #bfdbfe; -fx-border-width: 1; -fx-border-radius: 20;
                       -fx-font-weight: bold; -fx-font-size: 12px;
                       -fx-background-radius: 20; -fx-padding: 9 18;"/>
    </HBox>

    <!-- Grille des cartes produits -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;
                       -fx-border-color: transparent;">
        <padding><Insets top="4"/></padding>
        <FlowPane fx:id="cardsContainer" hgap="18" vgap="18" alignment="TOP_LEFT"
                  style="-fx-background-color: transparent; -fx-padding: 20 28 20 28;"/>
    </ScrollPane>

</VBox>
